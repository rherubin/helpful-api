# Environment variables for Railway deployment
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production

PORT=9000
# DEFAULT_STEPS_REQUIRED_FOR_UNLOCK=7  # Uncomment and set to override the default of 0

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4

# Set TEST_MOCK_LLM=true to return deterministic mock LLM responses from
# the server so tests never spend real tokens.
# TEST_MOCK_LLM=true

# MySQL Database Configuration (for local development)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=helpful_local_root_2024
MYSQL_DATABASE=helpful_db

# Or use a single MySQL URL (Railway format)
# MYSQL_URL=mysql://root:helpful_local_root_2024@localhost:3306/helpful_db

# ─────────────────────────────────────────────────────────────────────────
# Push notifications (Firebase Cloud Messaging via firebase-admin)
# ─────────────────────────────────────────────────────────────────────────
# Provide ONE of the two options below. Without either, push sends silently
# no-op (PushNotificationService.isConfigured() === false) and the rest of
# the API stays healthy — useful for local dev and CI.
#
# Option 1 (recommended for Railway / Vercel / containerized deploys):
#   The full Firebase service-account JSON as a single-line string. The
#   embedded `\n` inside private_key is correct JSON encoding — JSON.parse
#   converts those back into real newlines at startup.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}
#
# Option 2 (recommended for local development if you keep the JSON on disk):
#   Path to the service-account JSON file. Make sure the file is gitignored.
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
#
# Set TEST_MOCK_PUSH=true to skip Firebase entirely and use a deterministic
# in-memory mock — every send returns "all success", no FCM calls.
# TEST_MOCK_PUSH=true
