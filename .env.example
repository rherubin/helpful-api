# Required: process exits if PORT is unset
PORT=9000
HOST=0.0.0.0

# JWT — required in production and on Railway. The server refuses to start
# if these are unset or still the public placeholders
# your-secret-key-change-in-production / your-refresh-secret-key-change-in-production.
# Production already has unique secrets (rotated November 2026). Locally, generate:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=14d
# JWT_ACCESS_TOKEN_EXPIRES_IN_SECONDS=86400
# JWT_REFRESH_TOKEN_EXPIRES_IN_SECONDS=1209600

# Admin registration gate (POST /api/admin/auth/register).
# Leave both unset in production after the first admin is bootstrapped.
# ALLOW_ADMIN_REGISTRATION=true
# ADMIN_REGISTRATION_SECRET=long-random-secret
# (Clients may send the secret as header x-admin-registration-secret or body.registration_secret)

# OpenAI (required for real LLM generation; omit or set TEST_MOCK_LLM=true for local/CI without tokens)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4
# TEST_MOCK_LLM=true

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=helpful_local_root_2024
MYSQL_DATABASE=helpful_db
# MYSQL_URL=mysql://root:helpful_local_root_2024@localhost:3306/helpful_db
# Set MYSQL_SSL=true to use TLS when connecting via MYSQL_HOST (MYSQL_URL always uses TLS).
# MYSQL_SSL=true
# Verify the server certificate. Defaults to false so existing Railway MySQL
# connections keep working if the cert is not in a public CA chain.
# Set to true once the chain is trusted (recommended).
# MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Rate limits (optional)
# USER_UPDATE_RATE_LIMIT=3
# DEVICE_TOKEN_RATE_LIMIT=10

# Program generation (optional)
# DEFAULT_STEPS_REQUIRED_FOR_UNLOCK=0
# PROGRAM_GENERATION_FOLLOWUP_ENABLED=true
# PROGRAM_GENERATION_FOLLOWUP_DELAY_MS=60000
# REGENERATION_POLL_INTERVAL_MS=30000

# Push / FCM (optional — API stays healthy without these)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# TEST_MOCK_PUSH=true
# PUSH_TOKEN_CLEANUP_INTERVAL_HOURS=24

# Stripe Billing (web subscriptions — Payment Element + Customer Portal + webhooks)
# Develop/test: sk_test_ / rk_test_ + test price IDs + test webhook secret.
# Production: rk_live_ (preferred) or sk_live_ + live price IDs + live webhook secret.
# Never point production at test keys — Payment Element will reject the mix.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# STRIPE_TRIAL_PERIOD_DAYS=7
# Comma-separated origins allowed for Checkout/Portal return URLs
# STRIPE_CHECKOUT_ALLOWED_ORIGINS=http://localhost:3000,https://your-web-host.example
# WEB_APP_ORIGIN=http://localhost:3000
# STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/get-started?billing=success
# STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/get-started?billing=cancel
# STRIPE_PORTAL_RETURN_URL=http://localhost:3000/get-started?flow=subscription
# Reconcile cron: re-check local subscriptions against Stripe (hours). 0 = off.
# STRIPE_RECONCILE_INTERVAL_HOURS=6
# STRIPE_RECONCILE_BATCH_LIMIT=50
# TEST_MOCK_STRIPE=true

# Orphaned-trial cleanup cron: cancels abandoned free-trial subscriptions
# (never got a payment method attached) and soft-deletes the throwaway
# placeholder account created before checkout. 0 = off.
# Defaults to dry-run (log only) until ORPHANED_CLEANUP_DRY_RUN=false is set.
# ORPHANED_CLEANUP_INTERVAL_HOURS=24
# ORPHANED_CLEANUP_AGE_HOURS=48
# ORPHANED_CLEANUP_BATCH_LIMIT=50
# ORPHANED_CLEANUP_DRY_RUN=true

# In-app purchase receipt endpoint (POST /api/subscription).
# iOS verifies StoreKit 2 JWS locally. Required for that path:
# Comma-separate to accept several builds (e.g. dev + prod on the dev server).
# APPLE_BUNDLE_ID=com.helpfullabs.couples
# Optional. Comma-separated Production,Sandbox. Defaults to both — App Review
# purchases with sandbox accounts against the production build.
# APPLE_IAP_ENVIRONMENT=Production,Sandbox
# Android verifies purchase tokens with the Google Play Developer API. Required
# for that path (otherwise Android receipts return 503). The full service
# account key JSON, or base64 of it. Setup: docs/google-play-billing.md
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"play-receipt-verifier@your-project.iam.gserviceaccount.com","token_uri":"https://oauth2.googleapis.com/token"}
# Optional. Comma-separated application ids to accept (default com.helpful.couples).
# GOOGLE_PLAY_PACKAGE_NAMES=com.helpful.couples
# Optional. Comma-separated subscription product ids that grant premium.
# GOOGLE_PLAY_PRODUCT_IDS=com.helpful.yearly.29.99,com.helpful.monthly.9.99
# Optional. false rejects license-tester purchases (default true, like Apple Sandbox).
# GOOGLE_PLAY_ALLOW_TEST_PURCHASES=true
# Optional. Renewal refresh job cadence (hours, 0 = off) and batch size.
# GOOGLE_PLAY_REFRESH_INTERVAL_HOURS=1
# GOOGLE_PLAY_REFRESH_BATCH_LIMIT=50
# Only enable the mock path for tests — it trusts client-supplied fields.
# TEST_MOCK_* flags have no effect when NODE_ENV or the Railway environment
# is production, even if they are still set on the service.
# TEST_MOCK_IAP=true
