# Required: process exits if PORT is unset
PORT=9000
HOST=0.0.0.0

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=14d
# JWT_ACCESS_TOKEN_EXPIRES_IN_SECONDS=86400
# JWT_REFRESH_TOKEN_EXPIRES_IN_SECONDS=1209600

# Admin registration gate (POST /api/admin/auth/register).
# Leave both unset in production after the first admin is bootstrapped.
# ALLOW_ADMIN_REGISTRATION=true
# ADMIN_REGISTRATION_SECRET=long-random-secret
# (Clients may send the secret as header x-admin-registration-secret or body.registration_secret)

# OpenAI (required for real LLM generation; omit or set TEST_MOCK_LLM=true for local/CI without tokens)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4
# TEST_MOCK_LLM=true

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=helpful_local_root_2024
MYSQL_DATABASE=helpful_db
# MYSQL_URL=mysql://root:helpful_local_root_2024@localhost:3306/helpful_db

# Rate limits (optional)
# USER_UPDATE_RATE_LIMIT=3
# DEVICE_TOKEN_RATE_LIMIT=10

# Program generation (optional)
# DEFAULT_STEPS_REQUIRED_FOR_UNLOCK=0
# PROGRAM_GENERATION_FOLLOWUP_ENABLED=true
# PROGRAM_GENERATION_FOLLOWUP_DELAY_MS=60000
# REGENERATION_POLL_INTERVAL_MS=30000

# Push / FCM (optional — API stays healthy without these)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# TEST_MOCK_PUSH=true
# PUSH_TOKEN_CLEANUP_INTERVAL_HOURS=24

# Stripe Billing (web subscriptions — Checkout + Customer Portal + webhooks)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# STRIPE_TRIAL_PERIOD_DAYS=7
# Comma-separated origins allowed for Checkout/Portal return URLs
# STRIPE_CHECKOUT_ALLOWED_ORIGINS=http://localhost:3000,https://your-web-host.example
# WEB_APP_ORIGIN=http://localhost:3000
# STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/get-started?billing=success
# STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/get-started?billing=cancel
# STRIPE_PORTAL_RETURN_URL=http://localhost:3000/get-started?flow=subscription
# TEST_MOCK_STRIPE=true

# In-app purchase receipt endpoint (POST /api/subscription).
# Without App Store / Play verification the API trusts client-supplied
# expiration dates — only enable the mock path for tests.
# TEST_MOCK_IAP=true
